# Configuración del servidor de Hostinger para myread.com.mx
# (equivalente a vercel.json: mismas ligas limpias y cabeceras de seguridad)

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Nunca mostrar archivos ocultos (.git, .gitignore, etc.)
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(vercel\.json|CNAME)$ - [F,L]

# Siempre https y sin www (compatible con el CDN de Hostinger)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Ligas limpias
RewriteRule ^privacidad/?$ privacidad.html [L]
RewriteRule ^terminos/?$ terminos.html [L]

# Regreso de Stripe (las ligas de pago mandan a /?pago=ok o /?pago=oxxo): página de «Gracias» con los pasos
# que siguen, en vez de solo un aviso en la portada.
RewriteCond %{QUERY_STRING} (^|&)pago=ok(&|$)
RewriteRule ^$ /gracias [R=302,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)pago=oxxo(&|$)
RewriteRule ^$ /gracias-oxxo [R=302,L,QSD]
RewriteRule ^gracias/?$ gracias.html [L]
RewriteRule ^gracias-oxxo/?$ gracias-oxxo.html [L]

# Paquete de instalación de READ (repositorio público BetoJaeger/read-descargas): .zip con el instalador, el
# Manual de uso y la Guía de instalación (lo arma app/tools/armar-paquete.mjs). Temporal (302) para cambiarlo en
# cada versión nueva: solo se actualiza la versión aquí; la liga de los correos y del panel no cambia.
RewriteRule ^descargar/?$ https://github.com/BetoJaeger/read-descargas/releases/download/v1.2.0/READ-1.2.0.zip [R=302,L]
RewriteRule ^manual/?$ https://github.com/BetoJaeger/read-descargas/releases/download/v1.2.0/READ-Manual-de-uso-1.2.0.pdf [R=302,L]

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://buy.stripe.com; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Páginas, estilos y scripts: el navegador pregunta si cambiaron en cada visita (así cada git push se ve
  # de inmediato); las imágenes sí se guardan una semana.
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
